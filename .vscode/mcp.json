{
  "servers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "-p",
        "3.13",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context=vscode",
        "--project",
        "${workspaceFolder}",
        "--open-web-dashboard",
        "false"
      ]
    }
  }
}